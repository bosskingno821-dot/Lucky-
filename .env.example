# ClipCraft Backend - 100% FREE Stack
# Railway pe deploy karte waqt inhi naamon se "Variables" mein apni actual keys daalni hongi

# Gemini AI - highlight detection ke liye (FREE tier, roz 1500 requests free)
# Lena hai: aistudio.google.com -> Get API Key
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx

# Cloudinary - clips store karne ke liye (FREE tier, 25GB free)
# Lena hai: cloudinary.com -> Free sign up -> Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Note: Transcription (Whisper) ab open-source model use karta hai,
# jo seedha server pe chalta hai - koi API key nahi chahiye, bilkul free!

PORT=3000
